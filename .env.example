# --- LLM provider -----------------------------------------------------------
# Default: Google Gemini (free tier available at https://aistudio.google.com/app/apikey)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Optional model overrides (defaults shown)
# LLM_MODEL_FAST=gemini-3.5-flash-lite       # extraction / parsing agents
# LLM_MODEL_REASONING=gemini-3.6-flash       # audience, pain points, strategy

# Any OpenAI-compatible provider instead (Groq, DeepSeek, OpenRouter, Ollama...):
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=your-provider-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL_FAST=openai/gpt-oss-20b
# LLM_MODEL_REASONING=openai/gpt-oss-120b

# --- Web search -------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key-here

# --- Public deploy ------------------------------------------------------------
# Max real runs per day on the server's own keys. Unset = unlimited (local dev).
# Set to 0 on a public deploy: visitors then use demo replays or their own keys.
# PUBLIC_DAILY_RUNS=0
# Last day the server's own keys may be used for live runs (inclusive):
# PUBLIC_RUNS_UNTIL=2026-11-05

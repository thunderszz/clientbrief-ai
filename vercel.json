{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api.main:app",
      "buildCommand": "cd web && npm ci && npm run build",
      "functions": {
        "api/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,docs/**,output/**,web/node_modules/**,web/src/**,web/public/**,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
